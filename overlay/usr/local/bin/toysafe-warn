#!/bin/sh
# ToySafe-Warnliste (lokal). Prüft Domains, Links und Adressen gegen eine SIGNIERTE Liste.
# Warnt nur. Sperrt nie, sendet nichts, speichert keine Eingaben.
#
#   toysafe-warn --update        Liste aus WARN_SOURCE holen (nur mit ausreichend Unterschriften)
#   toysafe-warn --status        Version, Anzahl, Prüfstand
#   toysafe-warn PRUEFWERT       Domain, Link oder Adresse prüfen
#
# Ausgabe-Codes: 0 = nicht gelistet, 1 = GELISTET (Warnung), 2 = Fehler oder keine geprüfte Liste.
set -eu

DIR="${TOYWARN_DIR:-/var/lib/toymesh/warnliste}"
CONF="${TOYWARN_CONF:-/etc/toymesh/warnliste.conf}"
KEYDIR="${TOYWARN_KEYDIR:-/etc/toymesh/keys}"
SIGLIB="${TOYMESH_LIB:-/usr/local/lib/toymesh}/sigcheck.sh"
WARN_SOURCE=""
THRESHOLD=2
[ -f "$CONF" ] && . "$CONF"

log() { echo "[toysafe-warn] $*"; logger -t toysafe-warn "$*" 2>/dev/null || true; }
die() { echo "[toysafe-warn] FEHLER: $*" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || die "jq fehlt"
[ -f "$SIGLIB" ] || die "Prüfbibliothek fehlt: $SIGLIB"
# shellcheck disable=SC1090
. "$SIGLIB"

verified_count() { count_valid_sigs "$DIR/current.json" "$DIR/current.sigs" "$KEYDIR"; }

# Prüfwert normalisieren: Kleinbuchstaben, ohne Schema, Pfad, Benutzer, Port, www und Endpunkt
normalize_host() {
  printf '%s' "$1" | tr 'A-Z' 'a-z' | sed -e 's#^[a-z][a-z0-9+.-]*://##' -e 's#[/?#].*$##' \
    -e 's#^.*@##' -e 's#:[0-9]*$##' -e 's#\.$##' -e 's#^www\.##'
}

cmd_update() {
  case "$WARN_SOURCE" in
    "") log "WARN_SOURCE ist leer – Warnliste ist aus"; exit 0 ;;
    https://*) ;;
    http://127.0.0.1*|http://localhost*) ;;
    *) die "WARN_SOURCE muss https:// sein" ;;
  esac
  SRC="${WARN_SOURCE%/}"
  TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
  get() { curl -sfL --max-time 60 "$1" -o "$2"; }
  get "$SRC/warnliste.json" "$TMP/w.json" || { log "Quelle nicht erreichbar – übersprungen"; exit 0; }
  mkdir -p "$TMP/sigs"
  for pub in "$KEYDIR"/*.pub; do
    n=$(basename "$pub" .pub)
    get "$SRC/warnliste.sigs/$n.sig" "$TMP/sigs/$n.sig" || true
  done
  GOOD=$(count_valid_sigs "$TMP/w.json" "$TMP/sigs" "$KEYDIR")
  [ "$GOOD" -ge "$THRESHOLD" ] || die "nur $GOOD gültige Unterschrift(en), nötig $THRESHOLD – Liste verworfen"
  jq -e '.schema == "toysafe-warnliste/1" and (.version|type=="string") and (.eintraege|type=="array")' \
    "$TMP/w.json" >/dev/null 2>&1 || die "Format ungültig"
  NEW=$(jq -r '.version' "$TMP/w.json")
  CUR=$(jq -r '.version // "0"' "$DIR/current.json" 2>/dev/null || echo 0)
  if [ "$NEW" = "$CUR" ]; then log "bereits aktuell ($CUR)"; exit 0; fi
  TOP=$(printf '%s\n%s\n' "$CUR" "$NEW" | sort -V | tail -n1)
  [ "$TOP" = "$NEW" ] || { log "installiert ist neuer ($CUR), $NEW wird ignoriert"; exit 0; }
  mkdir -p "$DIR/current.sigs"
  cp "$TMP/w.json" "$DIR/current.json.new" && mv -f "$DIR/current.json.new" "$DIR/current.json"
  rm -rf "$DIR/current.sigs.new" && cp -r "$TMP/sigs" "$DIR/current.sigs.new" && rm -rf "$DIR/current.sigs" && mv "$DIR/current.sigs.new" "$DIR/current.sigs"
  log "Warnliste aktualisiert: $CUR -> $NEW ($(jq '.eintraege|length' "$DIR/current.json") Einträge, $GOOD Unterschriften)"
}

cmd_status() {
  [ -f "$DIR/current.json" ] || { echo "Keine Warnliste installiert."; exit 2; }
  V=$(jq -r '.version' "$DIR/current.json"); N=$(jq '.eintraege|length' "$DIR/current.json")
  G=$(verified_count)
  echo "Version $V · $N Einträge · $G von $THRESHOLD Unterschriften gültig"
  [ "$G" -ge "$THRESHOLD" ] && exit 0 || exit 2
}

cmd_check() {
  IN="$1"
  [ -f "$DIR/current.json" ] || die "keine Warnliste installiert (toysafe-warn --update)"
  G=$(verified_count)
  [ "$G" -ge "$THRESHOLD" ] || die "Warnliste hat nur $G von $THRESHOLD gültigen Unterschriften – nicht verwendet"
  LOW=$(printf '%s' "$IN" | tr 'A-Z' 'a-z')
  case "$LOW" in
    0x[0-9a-f]*)
      HIT=$(jq -r --arg a "$LOW" '.eintraege[] | select(.typ=="adresse") | select((.wert|ascii_downcase)==$a) | .grund' "$DIR/current.json" | head -n1) ;;
    *)
      HOST=$(normalize_host "$IN")
      HIT=$(jq -r --arg h "$HOST" '.eintraege[] | select(.typ=="domain") | . as $e | select(($h == $e.wert) or ($h | endswith("." + $e.wert))) | $e.grund' "$DIR/current.json" | head -n1)
      echo "geprüft: $HOST" ;;
  esac
  if [ -n "$HIT" ]; then
    echo "WARNUNG: gelistet – $HIT"
    echo "Nichts wurde blockiert. Entscheide selbst, ob du weitermachst."
    exit 1
  fi
  echo "nicht gelistet (kein Beleg für Sicherheit, nur keine bekannte Warnung)"
  exit 0
}

case "${1:-}" in
  --update) cmd_update ;;
  --status) cmd_status ;;
  "")       echo "Verwendung: toysafe-warn --update | --status | PRUEFWERT"; exit 2 ;;
  -h|--help) sed -n '2,9p' "$0" ;;
  *)        cmd_check "$1" ;;
esac
