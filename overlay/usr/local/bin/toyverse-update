#!/bin/sh
# ToyMesh — sicheres OS-Update.
#
#   toyverse-update              Snapshot, Update, Dienstprüfung (Standard, täglich per cron)
#   toyverse-update --status     letzter Lauf, ausstehende Updates, Neustart nötig?
#   toyverse-update --restore S  Pakete aus Snapshot S wieder auf die alten Versionen setzen
#   toyverse-update --list       vorhandene Snapshots anzeigen
#
# apk prüft jede Paketsignatur gegen /etc/apk/keys. Dieses Skript ändert daran nichts.
# Neue Kernel- oder Boot-Pakete werden NICHT automatisch aktiv: es entsteht nur die
# Markierung /var/lib/toymesh/reboot-required. Den Neustart machst du selbst.
set -eu

STATE=/var/lib/toymesh
SNAPDIR=$STATE/os-snapshots
LOG=/var/log/toyverse-update.log
REBOOT_FLAG=$STATE/reboot-required
KEEP=5

mkdir -p "$SNAPDIR"
chmod 0700 "$STATE" 2>/dev/null || true

log() {
    echo "[toyverse-update] $*"
    logger -t toyverse-update "$*" 2>/dev/null || true
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" >> "$LOG" 2>/dev/null || true
}

# installierte Pakete als "name-version-rN", sortiert
snapshot_now() { apk info -v 2>/dev/null | sort; }

# Pakete, die Kernel oder Start betreffen: Änderung heißt Neustart nötig
BOOT_RE='^(linux-|postmarketos-base|mkbootimg|initramfs|u-boot|postmarketos-initramfs|boot-deploy)'

prune_snapshots() {
    # nur die letzten $KEEP Snapshots behalten
    N=$(ls -1 "$SNAPDIR"/*.txt 2>/dev/null | grep -vc '\.after\.txt$' || true)
    [ "$N" -le "$KEEP" ] && return 0
    ls -1 "$SNAPDIR"/*.txt | grep -v '\.after\.txt$' | sort | head -n "$((N - KEEP))" | while read -r f; do
        rm -f "$f" "${f%.txt}.after.txt"
    done
}

check_services() {
    for svc in toyverse-web nftables; do
        if rc-service "$svc" status >/dev/null 2>&1; then
            : # läuft
        elif rc-service "$svc" start >/dev/null 2>&1; then
            log "Dienst $svc nach Update neu gestartet"
        else
            log "WARNUNG: Dienst $svc läuft nicht nach dem Update"
        fi
    done
}

cmd_update() {
    TS=$(date -u +%Y%m%dT%H%M%SZ)
    BEFORE="$SNAPDIR/$TS.txt"
    snapshot_now > "$BEFORE"
    log "Snapshot vor Update: $BEFORE ($(wc -l < "$BEFORE") Pakete)"

    log "Paketindex aktualisieren"
    if ! apk update >/dev/null 2>&1; then
        log "Paketindex nicht erreichbar – Update übersprungen"
        exit 0
    fi

    log "Pakete aktualisieren"
    if ! apk upgrade --no-interactive; then
        log "FEHLER: apk upgrade ist abgebrochen. Snapshot $BEFORE bleibt erhalten."
        exit 1
    fi

    AFTER="$SNAPDIR/$TS.after.txt"
    snapshot_now > "$AFTER"
    CHANGED=$(diff "$BEFORE" "$AFTER" | grep '^>' | sed 's/^> //' || true)
    if [ -z "$CHANGED" ]; then
        log "Keine Paketänderungen"
    else
        log "Geänderte Pakete: $(echo "$CHANGED" | wc -l)"
        echo "$CHANGED" | while read -r p; do log "  neu: $p"; done
        if echo "$CHANGED" | grep -Eq "$BOOT_RE"; then
            date -u +%Y-%m-%dT%H:%M:%SZ > "$REBOOT_FLAG"
            log "NEUSTART NÖTIG: Kernel- oder Start-Pakete wurden aktualisiert (doas reboot)"
        fi
    fi

    check_services

    prune_snapshots
    log "fertig"
}

cmd_status() {
    echo "Letzter Lauf:"
    tail -n 3 "$LOG" 2>/dev/null || echo "  (noch keiner)"
    echo
    N=$(apk version -l '<' 2>/dev/null | grep -c . || true)
    echo "Ausstehende Paket-Updates: $N"
    if [ -f "$REBOOT_FLAG" ]; then
        echo "Neustart nötig seit: $(cat "$REBOOT_FLAG")"
    else
        echo "Neustart nötig: nein"
    fi
}

cmd_list() {
    ls -1 "$SNAPDIR"/*.txt 2>/dev/null | grep -v '\.after\.txt$' || echo "(keine Snapshots)"
}

cmd_restore() {
    SNAP="${1:?Snapshot-Datei fehlt (siehe --list)}"
    [ -f "$SNAP" ] || { echo "Snapshot nicht gefunden: $SNAP" >&2; exit 1; }
    snapshot_now > "$STATE/restore-before.txt"

    # "name-1.2-r0" -> "name=1.2-r0"
    sed -E 's/^(.*)-([0-9][^-]*-r[0-9]+)$/\1=\2/' "$SNAP" > "$STATE/restore-list.txt"

    FAIL=0
    while read -r spec; do
        pkg=${spec%%=*}
        cur=$(apk info -v "$pkg" 2>/dev/null | head -n1 || true)
        want=${spec#*=}
        case "$cur" in
            "$pkg-$want") continue ;;   # schon in der richtigen Version
        esac
        if apk add --no-interactive "$spec" >/dev/null 2>&1; then
            log "zurückgesetzt: $spec"
        else
            log "FEHLER: $spec ist im Mirror nicht mehr verfügbar"
            FAIL=$((FAIL + 1))
        fi
    done < "$STATE/restore-list.txt"

    rm -f "$STATE/restore-list.txt"
    if [ "$FAIL" -gt 0 ]; then
        log "Zurücksetzen unvollständig: $FAIL Paket(e) nicht möglich"
        exit 1
    fi
    log "Zurücksetzen abgeschlossen (Snapshot $SNAP). Bitte Neustart prüfen."
    date -u +%Y-%m-%dT%H:%M:%SZ > "$REBOOT_FLAG"
}

case "${1:-}" in
    "")         cmd_update ;;
    --status)   cmd_status ;;
    --list)     cmd_list ;;
    --restore)  shift; cmd_restore "${1:-}" ;;
    -h|--help)  sed -n '2,8p' "$0" ;;
    *)          echo "unbekannte Option: $1" >&2; exit 2 ;;
esac
