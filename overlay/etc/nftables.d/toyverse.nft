#!/usr/sbin/nft -f
# ToyVerse Tab firewall — default-deny inbound, allow outbound.
# Loaded by the nftables OpenRC service. Flush first so re-apply is clean.

flush ruleset

table inet filter {

    # ---- sets you can edit ----
    # Hosts allowed to reach SSH (leave empty to allow from any LAN host,
    # or lock to your workstation's IP). Example: { 192.168.1.10 }
    set ssh_allow {
        type ipv4_addr
        flags interval
        # elements = { 192.168.0.0/16, 10.0.0.0/8 }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        # loopback: trust (this is where the ToyVerse app server lives)
        iif "lo" accept
        iifname != "lo" ip daddr 127.0.0.0/8 drop   # anti-spoof loopback
        iifname != "lo" ip6 daddr ::1/128 drop

        # stateful
        ct state established,related accept
        ct state invalid drop

        # ICMP (ping/neighbour discovery), rate-limited
        ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 10/second accept
        ip6 nexthdr ipv6-icmp accept

        # SSH — rate-limited, optionally restricted to ssh_allow.
        # Comment this block out entirely if you don't run sshd.
        tcp dport 22 ct state new limit rate 6/minute accept

        # NOTE: the ToyVerse app server binds to 127.0.0.1 only, so it is
        # reachable from the device itself and is NOT opened here on purpose.

        # everything else: dropped by policy (logged lightly)
        limit rate 5/minute log prefix "nft-drop-in " level info
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
